---
import ctaImage from "../assets/images/cta-section.jpeg";
---

<section aria-label="Llamada a la acción" style="padding:48px 0; background:white;">
  <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
    <a
      href="https://www.youtube.com/watch?v=-QPV4I3X6kA"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Ver video de presentación de TRAMA Cowork en YouTube"
      class="block w-full"
    >
      <img
        src={ctaImage.src}
        alt="Conocé TRAMA Cowork — mirá el video en YouTube"
        class="w-full h-auto block"
        loading="lazy"
      />
    </a>
  </div>
</section>
