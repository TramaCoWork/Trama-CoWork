---
import partners from "../data/partners.json";

const partnerImages = import.meta.glob<{ default: string }>(
  "/src/assets/partners/*.{png,svg,jpg,jpeg,webp}",
  { eager: true }
);

function resolveLogoSrc(filename: string): string {
  const key = `/src/assets/partners/${filename}`;
  return partnerImages[key]?.default ?? "";
}
---

<section style="padding:48px 0; background:white; overflow:hidden;">
  <div style="max-width:1200px; margin:0 auto; padding:0 24px 24px;">
    <h2
      style="font-size:22px; font-weight:700; color:#111827; text-align:center; border-bottom:3px solid #087781; padding-bottom:6px; display:inline-block; width:100%;"
    >
      Empresas que confían en nosotros
    </h2>
  </div>

  <div class="carousel-container" aria-label="Logos de empresas partners" role="region">
    <ul class="carousel-track" aria-hidden="true">
      {partners.map((partner) => (
        <li class="carousel-item">
          <img
            src={resolveLogoSrc(partner.filename)}
            alt={partner.alt}
            width="200"
            height="100"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
      {partners.map((partner) => (
        <li class="carousel-item" aria-hidden="true">
          <img
            src={resolveLogoSrc(partner.filename)}
            alt=""
            width="200"
            height="100"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .carousel-container {
    overflow: hidden;
    width: 100%;
    cursor: default;
  }

  .carousel-track {
    display: flex;
    width: max-content;
    list-style: none;
    margin: 0;
    padding: 0;
    animation: marquee 35s linear infinite;
  }

  .carousel-container:hover .carousel-track {
    animation-play-state: paused;
  }

  .carousel-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 40px;
    flex-shrink: 0;
    height: 80px;
  }

  .carousel-item img {
    max-height: 60px;
    max-width: 120px;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.6;
    transition: filter 0.3s, opacity 0.3s;
    display: block;
  }

  .carousel-item img:hover {
    filter: none;
    opacity: 1;
  }

  @media (max-width: 640px) {
    .carousel-item {
      padding: 0 24px;
      height: 60px;
    }

    .carousel-item img {
      max-height: 40px;
      max-width: 80px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      animation: none;
    }
  }
</style>
